APP_NAME=YaFaBa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=yafaba
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# DigitalOcean Spaces (S3-compatible) — used for the "spaces" disk
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_URL=

# GitHub API integration
GITHUB_API_TOKEN=

# Enrichment pipeline settings
ENRICHMENT_MIN_RUN_INTERVAL_HOURS=24
# ENRICHMENT_QUEUE=enrichment
# ENRICHMENT_JOB_TRIES=3
# ENRICHMENT_LLM_PER_MINUTE=60
# ENRICHMENT_EMBEDDING_PER_MINUTE=120
# ENRICHMENT_BATCH_CONCURRENCY=5
# ENRICHMENT_TRANSPORT=api
# CLAUDE_CLI_BINARY=claude
# ENRICHMENT_EMBEDDING_MODEL=voyage-3.5
# ENRICHMENT_EMBEDDING_BATCH_SIZE=64
# ENRICHMENT_MIN_CHUNK_CHARS=200
# ENRICHMENT_MAX_CHUNK_CHARS=4000
# ENRICHMENT_EMBEDDING_QUEUE=enrichment-embedding
# ENRICHMENT_EMBEDDING_MAX_WAIT_SECONDS=1500
# ENRICHMENT_MODEL_DEFAULT=claude-sonnet-5
# ENRICHMENT_MODEL_CARD_EXPLAINER=claude-sonnet-5
# ENRICHMENT_MODEL_COMBO_TAGGING=claude-haiku-4-5-20251001
# ENRICHMENT_MODEL_SYNERGY_TAGGING=claude-haiku-4-5-20251001
# ENRICHMENT_LLM_MAX_TOKENS=2048
# ENRICHMENT_API_MAX_ATTEMPTS=3
# ENRICHMENT_RETRIEVAL_TOP_K=8
# ENRICHMENT_RETRIEVAL_COMBO_CANDIDATE_TOP_K=8
# ENRICHMENT_RETRIEVAL_COMBO_POOL_LIMIT=50
# ENRICHMENT_RETRIEVAL_COMBO_EXAMPLES_TOP_K=5
# ENRICHMENT_RETRIEVAL_SYNERGY_EXAMPLES_TOP_K=5
# Queue driver: QUEUE_CONNECTION=database locally (default above); set QUEUE_CONNECTION=redis in production.

# Voyage AI embeddings
VOYAGE_API_KEY=
# VOYAGE_API_URL=https://api.voyageai.com/v1

# Anthropic (Claude) API
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
